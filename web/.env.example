# Base URL of the JalTaap API Gateway HTTP API (no trailing slash).
VITE_API_URL=https://abc123.execute-api.ap-south-1.amazonaws.com
# Amazon Location Service API key for the Maps v2 style. Leave empty to use OpenFreeMap.
VITE_MAP_KEY=
# AWS region for Amazon Location and Cognito.
VITE_AWS_REGION=ap-south-1
# Cognito user pool for the officer view.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Optional links shown on /about. Hidden when empty.
VITE_REPO_URL=
VITE_VIDEO_URL=
# Development only: serve fixtures from src/mocks and show a "MOCK DATA" banner.
# Never set this in Amplify Hosting.
VITE_USE_MOCK=false
